# API
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
SENTRY_DSN=

# Database (local Supabase defaults; replace for a hosted project)
DATABASE_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase server credentials
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
SUPABASE_S3_REGION=local
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_DEFAULT_BUCKET=uploads

# Frontend: every VITE_ value is public and included in the browser bundle.
VITE_API_URL=http://localhost:3000
VITE_NODE_ENV=development
VITE_SENTRY_DSN=
VITE_DEMO_USER_EMAIL=test@test.com
VITE_DEMO_USER_PASSWORD=Testpassword123
VITE_DEMO_MANAGER_EMAIL=manager@demo.com
VITE_DEMO_MANAGER_PASSWORD=Managerpassword123

# Playwright
E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:3000
E2E_EMAIL=test@test.com
E2E_PASSWORD=Testpassword123
