{
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "supabase": "2.121.0",
    "turbo": "^2.11.10"
  },
  "private": true,
  "scripts": {
    "dev": "turbo dev --parallel",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=api",
    "build:web": "turbo run build --filter=web",
    "type-check": "turbo run type-check",
    "lint": "turbo run lint",
    "test": "pnpm --filter api test"
  },
  "packageManager": "pnpm@10.34.7"
}
