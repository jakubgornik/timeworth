{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": [".env"],
    "globalEnv": ["NODE_ENV", "VITE_*"],
    "globalPassThroughEnv": [
        "DATABASE_URL",
        "DIRECT_URL",
        "SUPABASE_*",
        "JWT_SECRET",
        "PORT",
        "CORS_ORIGIN",
        "SENTRY_DSN",
        "E2E_*"
    ],
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist/**",
                "prisma/client/**"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "db:generate": {
            "cache": false
        },
        "db:migrate": {
            "cache": false,
            "persistent": true
        },
        "db:deploy": {
            "cache": false
        }
    }
}
