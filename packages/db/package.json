{
    "name": "@packages/db",
    "version": "0.1.0",
    "main": "./dist/index.js",
    "types": "./src/index.ts",
    "dependencies": {
        "@nestjs/common": "^11.2.7",
        "@prisma/adapter-pg": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "@prisma/client-runtime-utils": "^7.10.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2"
    },
    "scripts": {
        "with-env": "dotenv -e ../../.env --",
        "build": "pnpm db:generate && tsc",
        "type-check": "pnpm db:generate && tsc --noEmit",
        "db:generate": "pnpm with-env prisma generate",
        "db:migrate": "pnpm with-env prisma migrate dev",
        "db:deploy": "pnpm with-env prisma migrate deploy",
        "db:pull": "pnpm with-env prisma db pull",
        "db:push": "pnpm with-env prisma db push",
        "db:reset": "pnpm with-env prisma migrate reset --force",
        "db:seed": "pnpm with-env ts-node prisma/seed.ts"
    },
    "devDependencies": {
        "@faker-js/faker": "^10.6.0",
        "@supabase/supabase-js": "^2.118.0",
        "@types/node": "^22.20.5",
        "dotenv-cli": "^11.0.0",
        "prisma": "^7.10.1",
        "ts-node": "^10.9.2",
        "typescript": "5.8.3"
    }
}
